# Segredo do JWT — gere um valor longo e aleatório em produção
TOKEN_SECRET=troque_por_um_segredo_forte

# Expiração do token JWT (ex: 24h, 7d)
TOKEN_EXPIRATION=24h

# Porta do servidor — no Render é injetada automaticamente
PORT=3000

# String de conexão do MongoDB
# Desenvolvimento: mongodb://127.0.0.1:27017/banco_dados
# Produção (MongoDB Atlas): mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/banco_dados

# Origens permitidas no CORS (separadas por vírgula)
# Coloque aqui a URL do seu app no Vercel
ALLOWED_ORIGINS=https://seu-app.vercel.app

NODE_ENV=production
