# Estágio 1: Instalação de dependências (Build)
FROM node:22-alpine AS dependencies
WORKDIR /app

# Instala dependências de sistema necessárias para pacotes nativos
RUN apk add --no-cache git python3 make g++

# Copia arquivos de definição de pacotes
COPY package.json yarn.lock ./

# Instala todas as dependências (incluindo devDependencies para build se necessário)
RUN yarn install --frozen-lockfile

# Estágio 2: Imagem Final de Execução (Runtime)
FROM node:22-alpine
WORKDIR /app

# Instala ferramentas essenciais para SRE/DevOps (Healthcheck e espera de rede)
RUN apk add --no-cache netcat-openbsd curl

# Copia apenas as node_modules do estágio anterior (limpo)
COPY --from=dependencies /app/node_modules ./node_modules

# Copia o restante do código da aplicação
COPY . .

# Variáveis de ambiente e porta
ENV NODE_ENV=development
EXPOSE 21165

# Comando com loop de espera para o MongoDB estar pronto antes de iniciar
CMD ["sh", "-c", "while ! nc -z mongo-bridgerton 27017; do sleep 1; done; yarn start"]